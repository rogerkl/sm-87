@@ -553,6 +556,32 @@ function saveStore(store) {
 const status = $("status"), cpu = $("cpu");
 let appPart = null;
 function showAlert(t) { $("alert").textContent = t; }
+
+// The FM-1 runs on the browser's audio thread: with no audio output working (a Bluetooth headset that switched itself
+// off, an output unplugged) it never starts ("Starting…" for ever) or it stops, with no error anywhere. Once the
+// audio clock has stood still for 3 s the page says so, on the switch while it's there and in the alert line (unless
+// that says something else); gone when the clock moves again
+const NO_SOUND = "No sound from the browser, so the FM-1 can't run: is an audio output on? (A Bluetooth headset may"
+  + " have switched itself off.) Choose one that works, then reload the page.";
+function watchSound(ac) {
+  const hint = document.createElement("p");
+  hint.className = "nosound";
+  hint.textContent = NO_SOUND;
+  let last = -1, still = 0;
+  const timer = setInterval(() => {
+    if (ac.state === "closed") { clearInterval(timer); return; }
+    const now = ac.currentTime;
+    still = now === last ? still + 1 : 0;
+    last = now;
+    if (still >= 3) {
+      if (!$("alert").textContent) showAlert(NO_SOUND);
+      if (!$("start").hidden && !hint.isConnected) $("start").append(hint);
+    } else if (still === 0) {
+      if ($("alert").textContent === NO_SOUND) showAlert("");
+      hint.remove();
+    }
+  }, 1000);
+}
 async function switchOn() {
   const go = $("go");
   go.disabled = true;
